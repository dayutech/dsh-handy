{
  "name": "dsh-handy",
  "version": "0.8.0",
  "description": "DeepSeek Harness Web plugin with per-session notes, a draggable key-information panel, fork inheritance of notes and key information, workspace-scoped session groups, highlighting, running-workspace prioritization, and bulk close actions for every right-sidebar tab.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "assets",
    "screenshots.json"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js && node scripts/validate-market.mjs",
    "check:market": "node scripts/validate-market.mjs",
    "prepack": "npm run build",
    "pack:dry": "npm pack --dry-run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-api-session-controller"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "handy",
    "fork",
    "session",
    "notebook",
    "key-info",
    "workspace"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dayutech/dsh-handy.git"
  },
  "homepage": "https://github.com/dayutech/dsh-handy#readme",
  "bugs": {
    "url": "https://github.com/dayutech/dsh-handy/issues"
  },
  "author": "dayutech",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.1-rc.3 <0.2.2-0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
